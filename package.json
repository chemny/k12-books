{
  "name": "chinak12-book-downloader",
  "version": "1.0.0",
  "description": "国家中小学智慧教育平台 K12 教材可视化批量下载器与版本管理系统 (纯 Node.js / Electron 原生实现)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev": "node server.js",
    "pack:mac": "electron-packager . ChinaK12BookDownLoader --platform=darwin --arch=arm64 --out=dist --overwrite --prune=true --ignore=\"^/dist$\""
  },
  "keywords": [
    "k12",
    "textbook",
    "smartedu",
    "downloader",
    "electron",
    "nodejs"
  ],
  "author": "scottcheng",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-packager": "^17.1.2"
  }
}
